<?xml version='1.0' encoding='utf-8'?>
<widget id="br.edu.ufv.cafediag" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>CafeDiag</name>
    <description>
        Diagnóstico de doenças do café por foto da folha.
    </description>
    <author email="dev@example.com" href="https://example.com">
        Equipe CafeDiag
    </author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <preference name="scheme" value="http" />
    <platform name="android">
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application">
            <application android:usesCleartextTraffic="true" />
        </edit-config>
    </platform>
</widget>